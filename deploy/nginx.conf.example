# Contoh reverse proxy untuk operationsurabaya.pipip.my.id
# Container berjalan di 127.0.0.1:8001 (lihat APP_PORT di docker-compose.yml)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name operationsurabaya.pipip.my.id;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name operationsurabaya.pipip.my.id;

    # Sesuaikan path sertifikat (mis. dari certbot)
    ssl_certificate     /etc/letsencrypt/live/operationsurabaya.pipip.my.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/operationsurabaya.pipip.my.id/privkey.pem;

    # Upload foto wajah / frame kamera bisa besar
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket: /socket.io/ (comms) dan /ws/referee-cam/ (kamera wasit)
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Jangan putus koneksi WebSocket yang idle
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
    }
}
